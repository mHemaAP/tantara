{
  "name": "tantara-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3010",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3010",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/features/cases/**/*.{ts,tsx,css}\" \"src/features/clients/**/*.{ts,tsx,css}\" \"src/features/tasks/**/*.{ts,tsx,css}\" \"src/features/calendar/**/*.{ts,tsx,css}\" \"src/features/dashboard/matters/**/*.{ts,tsx,css}\" \"src/app/\\\\(workspace\\\\)/cases/**/*.tsx\" \"src/app/\\\\(workspace\\\\)/clients/**/*.tsx\" \"src/app/\\\\(workspace\\\\)/tasks/**/*.tsx\" \"src/app/\\\\(workspace\\\\)/calendar/**/*.tsx\" \"tests/*.ts\" \"tests/*.mjs\"",
    "gen:api": "node scripts/gen-api.mjs",
    "screenshots": "node tests/capture-owned-routes.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-table": "^8.21.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "prettier": "^3.5.3",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.19.0",
    "eslint-config-next": "15.5.9",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
