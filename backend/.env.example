# Local-first configuration. Never place secrets in this file.
DATABASE_URL=sqlite:///data/tantara.db
DATA_DIR=data
AI_PROVIDER=local
LOCAL_LLM_BASE_URL=http://192.168.0.101:8080/v1
LOCAL_LLM_MODEL=MiniCPM5-2B
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
# auto = PostgreSQL vectors when DATABASE_URL is PostgreSQL, otherwise local FAISS.
VECTOR_BACKEND=auto
# PostgreSQL workspace database (the deployed configuration):
# DATABASE_URL=postgresql+psycopg://tantara:tantara@192.168.0.100:5432/tantra
# DB_POOL_SIZE=5
# DB_POOL_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800
# Object storage for uploads and filing bundles: filesystem (default) or s3 (MinIO).
OBJECT_STORAGE=filesystem
# S3_ENDPOINT=http://192.168.0.100:9000
# S3_BUCKET=tantara
# S3_ACCESS_KEY=            # or MINIO_ACCESS_KEY
# S3_SECRET_KEY=            # or MINIO_SECRET_KEY
# S3_REGION=us-east-1
# S3_SECURE=false
ANALYTICS_BACKEND=none
ENABLE_CLOUD_PROVIDERS=false
MAX_UPLOAD_MB=25
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=250
DEFAULT_TOP_K=5
TANTARA_ADMIN_PASSWORD=tantara-local
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3008,http://localhost:3009,http://localhost:3010,http://localhost:3011,http://localhost:3012,http://localhost:3013,http://localhost:3014,http://localhost:3015,http://localhost:3016,http://localhost:3017,http://localhost:3018,http://localhost:3019,http://localhost:3020,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003,http://127.0.0.1:3004,http://127.0.0.1:3005,http://127.0.0.1:3006,http://127.0.0.1:3007,http://127.0.0.1:3008,http://127.0.0.1:3009,http://127.0.0.1:3010,http://127.0.0.1:3011,http://127.0.0.1:3012,http://127.0.0.1:3013,http://127.0.0.1:3014,http://127.0.0.1:3015,http://127.0.0.1:3016,http://127.0.0.1:3017,http://127.0.0.1:3018,http://127.0.0.1:3019,http://127.0.0.1:3020
# Optional cloud adapter configuration:
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
