# TANTRA frontend: Next.js standalone server.
# Build context is the repository root:
#   podman build -f deploy/Containerfile.frontend .
FROM docker.io/node:24-slim AS build

WORKDIR /app
RUN npm install --global pnpm@12.5.1

# pnpm-workspace.yaml carries the build-script allowlist (sharp, unrs-resolver);
# without it pnpm 12 refuses to install.
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ ./
# Baked into the Next rewrite table; public traffic is routed at the edge, so this
# only matters when a request reaches the frontend pod directly.
ARG TANTARA_API_ORIGIN=http://tantara-backend.tantara.svc.cluster.local:8010
ARG TANTARA_WORKSPACE_TIME_ZONE=Asia/Kolkata
ENV NEXT_TELEMETRY_DISABLED=1 \
    TANTARA_API_ORIGIN=$TANTARA_API_ORIGIN \
    TANTARA_WORKSPACE_TIME_ZONE=$TANTARA_WORKSPACE_TIME_ZONE
RUN pnpm build

FROM docker.io/node:24-slim AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

WORKDIR /app
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 --ingroup nodejs nextjs

COPY --from=build --chown=nextjs:nodejs /app/public ./public
COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
ENTRYPOINT ["node", "server.js"]
