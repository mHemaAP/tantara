# TANTRA backend: FastAPI + Alembic + FastEmbed + OCR + PostgreSQL/MinIO clients.
# Build context is the repository root:
#   podman build -f deploy/Containerfile.backend .
FROM docker.io/library/python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DATA_DIR=/data \
    HOME=/data \
    FASTEMBED_CACHE_PATH=/opt/models/fastembed

# libgl1/libglib2.0-0 are required by the OpenCV wheel that rapidocr pulls in.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install -r /app/backend/requirements.txt

COPY backend/ /app/backend/
COPY scripts/ /app/scripts/

# Bake the embedding and OCR model caches into the image so a starting pod never
# depends on model-hosting services or a writable model cache.
ARG FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RUN python -c "from fastembed import TextEmbedding; model = TextEmbedding('${FASTEMBED_MODEL}'); print('embedding warm, dimensions:', len(list(model.embed(['warmup']))[0]))" \
    && python -c "from rapidocr_onnxruntime import RapidOCR; RapidOCR(); print('ocr warm')"

# Served pods never call the model hub: the caches above are part of the image.
ENV HF_HUB_OFFLINE=1

RUN useradd --system --uid 1000 --create-home --home-dir /data tantara \
    && mkdir -p /data \
    && chown -R tantara:tantara /data /app /opt/models

USER tantara
WORKDIR /app/backend
EXPOSE 8010

# One worker keeps the in-process ingestion lock and rate limiter exact; uploads
# are processed on the ingestion thread pool and vectors live outside the process.
ENTRYPOINT ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8010", "--workers", "1"]
